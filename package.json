{
  "name": "fov-explorer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive sensor × focal length → field of view explorer",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "biome check --error-on-warnings .",
    "fmt": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@types/node": "^25.6.2",
    "@vitest/coverage-istanbul": "^2.1.0",
    "fast-check": "^3.23.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^2.1.0"
  }
}
